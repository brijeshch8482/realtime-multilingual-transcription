# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live model. 2.5 native-audio streams word by word (3.1 Flash Live only returns text after each sentence).
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Live API version. v1alpha works with all key types (v1beta 404s for AQ.* keys)
GEMINI_API_VERSION=v1alpha

# Silence (ms) after which Gemini ends a phrase -> lower = text appears sooner
SILENCE_MS=500

# Leave empty to use local SQLite (backend/transcriptions.db).
# With docker compose Postgres running locally:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/transcriptions
DATABASE_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Fast text model: fixes scripts per phrase ("प्रोजेक्ट" -> "project") + language ID on save. Empty = off.
NORMALIZE_MODEL=gemini-3.5-flash-lite

# Accurate pass over the whole recording when you press Stop (replaces the live draft).
# Tried in order; free-tier quotas are per model (e.g. 20/day for 3.5-flash). Empty = off.
FINAL_MODELS=gemini-3.5-flash:minimal,gemini-3.1-flash-lite,gemini-3.8-flash:low,gemini-3.7-flash:low
